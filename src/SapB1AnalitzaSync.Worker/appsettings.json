{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "ServiceLayer": {
    "BaseUrl": "https://<sap-host>:50000/b1s/v1/",
    "CompanyDb": "<CompanyDB>",
    "UserName": "<usuari-tecnic-nomes-lectura>",
    "Password": "<from-secrets-manager>",
    "ConnectTimeoutSeconds": 10,
    "RequestTimeoutSeconds": 120,
    "PageSize": 500,
    "AllowInvalidCertificates": false,
    "SessionMinutes": 29
  },

  "Database": {
    "ConnectionString": "Server=<sql-host>;Database=IntercanviSAP;User Id=<usuari-escriptura-sap_raw>;Password=<from-secrets-manager>;TrustServerCertificate=True;Encrypt=True",
    "CommandTimeoutSeconds": 300,
    "BulkBatchSize": 5000
  },

  "Sync": {
    "OverlapDays": 1,
    "DocumentFlushSize": 500,
    "PriceField": "UnitPrice",
    "CostField": "StockInmPrice"
  }
}
