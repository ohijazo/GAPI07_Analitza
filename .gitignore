# Build output
bin/
obj/

# .NET user-secrets: els secrets viuen a %APPDATA%\Microsoft\UserSecrets, no al repo.
# Aquesta línia és una xarxa de seguretat per si algun cop en cau un a dins.
**/secrets.json

# Configuració local de Claude Code (per projecte)
.claude/settings.local.json

# Logs locals del Worker
logs/
**/logs/

# Fitxers temporals de proves manuals contra Service Layer (cookies de sessió, respostes de login)
**/.sl_cookies
**/.sl_login_response.json

# Sortides de la sonda de Fase 0: poden contenir dades reals de clients
tools/spike/out/

# Credencials i connexions
*.env
.env

# IDE
.vs/
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store
~$*.docx

# Skills instal.lades amb `npx skills add`. Son eines de l'entorn de treball,
# no contingut del projecte, i ocupen un parell de MB duplicats (a Windows els
# symlinks fallen i es copien a .agents i a .claude alhora).
.agents/
.claude/skills/
skills-lock.json

# Sortida de dotnet publish per desplegar al servidor (regenerable, ~70 MB)
publish/

# Exportacions que ens passa Analitza: son dades personals de clients reals
# (nom, adreca, telefon, correu). Fan falta al disc perque la sonda hi compari
# la continuitat d'IDs (Sync:KaisClientExportPath), pero no han d'entrar a
# l'historic de git. A mes son una fotografia amb data: se n'ha de demanar una
# de nova just abans del tall.
docs/client_locations*.csv

# Bytecode de Python (tools/)
__pycache__/
*.pyc
